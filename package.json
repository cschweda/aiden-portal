{
  "name": "aiden-portal",
  "version": "0.18.3",
  "description": "Personal web app for controlling a Fellow Aiden coffee brewer",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node --env-file=.env .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && scripts/check-shell.sh",
    "typecheck": "nuxt typecheck && tsc -p tests --noEmit",
    "postinstall": "nuxt prepare",
    "mock:fellow": "node scripts/mock-fellow.mjs",
    "build:demo": "AIDEN_DEMO=1 nuxt generate"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.1",
    "h3": "^1.15.11",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
