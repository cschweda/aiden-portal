# =============================================================================
#  aiden-studio — environment file
#
#  Copy this file to `.env` (which is git-ignored) and fill in the values:
#
#      cp .env.sample .env
#      chmod 600 .env        # it will hold your real Fellow password
#
#  Only the two Fellow credentials are required. Everything else about the app
#  (bind address, dry run, cache, retries, logging, UI) lives in aiden.config.ts
#  at the repo root, which is the single source of truth and is compiled into
#  each build. The optional keys further down let you override one of those
#  values for a single run without editing the file; leave them blank otherwise.
#
#  In development, `pnpm dev` reads this file automatically. In production the
#  built server does not: run it with `node --env-file=.env .output/server/index.mjs`
#  (which is what `pnpm start` and the launchd plist do).
# =============================================================================


# ---- Fellow account (required) ----------------------------------------------
# The email and password you use in the Fellow app on your phone. They are read
# once at startup, sent only to Fellow's API, never logged, and never sent to
# the browser. Fellow has no API keys, so the login is the only way in.
FELLOW_EMAIL=
FELLOW_PASSWORD=


# ---- Optional overrides ------------------------------------------------------
# Each of these overrides the matching value in aiden.config.ts for this run.
# Blank means "use aiden.config.ts". Unknown keys are ignored.

# true/false. When true, every profile, schedule, and brew-start change is logged
# instead of being sent to Fellow; reads still go through. Overrides fellow.dryRun.
FELLOW_DRY_RUN=

# IANA zone sent to Fellow at login, e.g. America/New_York. Overrides fellow.timezone
# (whose null means "this machine's zone").
FELLOW_TIMEZONE=

# Address to listen on. Phase 1 has no login screen, so the startup guard refuses
# anything that is not 127.0.0.1, ::1, or localhost. Overrides server.host.
HOST=

# Port to listen on. Overrides server.port.
PORT=

# Comma-separated hostnames accepted in the Host header, as they appear there
# (port ignored, IPv6 in brackets). Overrides server.allowedHosts.
ALLOWED_HOSTS=

# Comma-separated Tailscale logins allowed to make changes through `tailscale serve`
# (as shown in the Tailscale admin console, e.g. you@github). Overrides server.tailnetUsers.
TAILNET_USERS=

# fatal | error | warn | info | debug | trace | silent. Overrides logging.level
# (whose null means info in production and debug in development).
LOG_LEVEL=

# true/false. false stops the background reads that feed the brew log, the brew
# trace, and the descale tally (the app then only reads when you open a page).
HISTORY_ENABLED=

# Where the brew log and the descale marker are written. Overrides history.directory.
HISTORY_DIRECTORY=

# ---- Development only ------------------------------------------------------
# Point the app at the mock brewer instead of Fellow's cloud (`pnpm mock:fellow` in another terminal).
# Only https, or plain http on a loopback address, is accepted. Leave blank to talk to the real Fellow API.
FELLOW_BASE_URL=
